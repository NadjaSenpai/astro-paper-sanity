# ---- Astro frontend (.env) ----
# Server-side (build / SSG). These never reach the browser bundle.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2025-05-03
SANITY_USE_CDN=true
SANITY_API_TOKEN=          # read token; only needed for private/embedded datasets — drafts are not served by this template

# Client-side mirror. The PUBLIC_ prefix tells Vite to inline these into
# the React island bundle so ImageWithModal etc. can build Sanity image
# URLs in the browser. Use the same values as the SANITY_* pair above.
# NEVER add a PUBLIC_SANITY_API_TOKEN here; that would leak the token.
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-05-03
PUBLIC_SANITY_USE_CDN=true

# Optional site metadata
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Sanity Studio (studio/.env) ----
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2025-05-03
