{
  "name": "astro-paper-sanity",
  "version": "2.0.0",
  "type": "module",
  "description": "Astro 6 + Sanity blog starter. Fork of satnaing/astro-paper with Sanity Studio replacing the original Markdown content layer.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@portabletext/react": "^3.2.4",
    "@portabletext/types": "^2.0.15",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/cli": "^3.99.0",
    "@sanity/client": "^7.12.0",
    "@sanity/code-input": "^5.2.1",
    "@sanity/image-url": "^1.2.0",
    "@sanity/structure": "^2.36.2",
    "@sanity/vision": "^3.99.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "lodash.kebabcase": "^4.1.1",
    "node-html-parser": "^7.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^3.99.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "shiki": "^4.1.0",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  }
